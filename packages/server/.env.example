# ---- Optional: the language model behind POST /api/summary and /api/form/assess --------------------------------
# Any OpenAI-compatible endpoint. Leave PPG_API_KEY empty to run without summaries: classification results, the public
# API and model hosting do not need it.
PPG_BASE_URL=https://api.openai.com/v1
PPG_API_KEY=
PPG_MODEL=gpt-4o-mini
# PPG_TEMPERATURE=0
# PPG_MAX_TOKENS=1200
# PPG_TIMEOUT_MS=30000

# ---- Server ---------------------------------------------------------------------------------------------------
PPG_PORT=8787
# SQLite file holding results (kept 30 days) and cached summaries.
# PPG_DB_FILE=./data/ppg.sqlite
# Model bundles served at /models/* (build manifest.json with `bun run models:manifest`).
# PPG_MODELS_DIR=./data/models

# ---- Who may upload results ------------------------------------------------------------------------------------
# `auth.txt` at the repository root by default; add users with `bun run auth add <username>`. Reading results is public;
# uploading needs one of these accounts.
# PPG_AUTH_FILE=./auth.txt

# ---- Hardening -------------------------------------------------------------------------------------------------
# Summaries are public but metered: requests per client address per hour, and across everybody.
# PPG_SUMMARY_PER_IP_HOUR=20
# PPG_SUMMARY_GLOBAL_HOUR=500
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For; otherwise clients could pick their own address.
# PPG_TRUST_PROXY=1
# Extra browser origins (comma separated) allowed to call the write routes. Extension origins always are.
# PPG_ALLOWED_ORIGINS=https://admin.example.org
