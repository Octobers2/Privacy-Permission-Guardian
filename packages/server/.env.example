# Any OpenAI-compatible endpoint.
PPG_BASE_URL=https://api.openai.com/v1
PPG_API_KEY=
PPG_MODEL=gpt-4o-mini

# Optional
PPG_PORT=8787
PPG_TEMPERATURE=0
PPG_MAX_TOKENS=1200
PPG_TIMEOUT_MS=30000
# PPG_CACHE_FILE=./data/summaries.sqlite

# Credentials. `auth.txt` at the repository root by default; add users with
# `bun run auth add <username>`. Nobody can use this server until you do.
# PPG_AUTH_FILE=./auth.txt

# The headless browser that renders client-side-rendered policy pages.
# PPG_CHROMIUM=chromium
# PPG_CHROMIUM_NO_SANDBOX=1   # containers usually have no user namespaces
