{
  "name": "privacy-permission-guardian",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "dev": "bun run --filter '@ppg/extension' dev",
    "build": "bun run --filter '@ppg/extension' build",
    "server": "bun run --filter '@ppg/server' dev",
    "auth": "bun run scripts/auth.ts",
    "favicons": "bun run scripts/gen-favicon-hashes.ts",
    "eval:rules": "bun run eval/run-rules-eval.ts",
    "fixtures": "bun run eval/serve-fixtures.ts",
    "fixtures:check": "bun run eval/sanitize-fixture.ts --check eval/fixtures/phishing/*.html eval/fixtures/legit/*.html",
    "models:manifest": "bun run scripts/model-manifest.ts",
    "demo": "bun run packages/server/scripts/demo.ts",
    "theme": "bun run --filter '@ppg/extension' theme",
    "e2e:banner": "bun run eval/run-banner-e2e.ts",
    "e2e:analysis": "bun run eval/run-analysis-e2e.ts",
    "e2e:setup": "bun run eval/run-setup-e2e.ts",
    "e2e:shared": "bun run eval/run-shared-e2e.ts",
    "e2e:site": "bun run eval/run-site-e2e.ts",
    "e2e": "bun run build && bun run e2e:banner && bun run e2e:analysis && bun run e2e:setup && bun run e2e:shared && bun run e2e:site"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "^0.0.287",
    "axe-core": "^4.14.0",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.50.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ppg/shared": "workspace:*"
  }
}
