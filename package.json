{
  "name": "privacy-permission-guardian",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "dev": "bun run --filter '@ppg/extension' dev",
    "build": "bun run --filter '@ppg/extension' build",
    "server": "bun run --filter '@ppg/server' dev",
    "auth": "bun run scripts/auth.ts",
    "eval:rules": "bun run eval/run-rules-eval.ts",
    "eval:injection": "bun run eval/run-injection-eval.ts",
    "e2e": "bun run --filter @ppg/extension build && bun run eval/run-e2e.ts",
    "fixtures": "bun run eval/serve-fixtures.ts",
    "fixtures:check": "bun run eval/sanitize-fixture.ts --check eval/fixtures/phishing/*.html eval/fixtures/legit/*.html"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "^0.0.287",
    "linkedom": "^0.18.13",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ppg/shared": "workspace:*"
  }
}
